    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src"
  ],
  "arh": {
    "distribution": "source-js",
    "requiresTranspile": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idiot95/rayhanat-design-system.git",
    "directory": "packages/access"
