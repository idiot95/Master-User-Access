      "source": "./src/proxy.js",
      "default": "./src/proxy.js"
    },
    "./verify": {
      "source": "./src/verify.js",
      "default": "./src/verify.js"
    }
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "publishConfig": {
