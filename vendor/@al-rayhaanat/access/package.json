{
  "name": "@al-rayhaanat/access",
  "version": "1.3.0",
  "description": "The module side of User Access — verify the signed envelope, gate the route, check the write.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.js",
