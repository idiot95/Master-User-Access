{
  "name": "@al-rayhaanat/system",
  "version": "1.3.0",
  "description": "The whole design system in one dependency — every package, plus the token stylesheet. Install this unless you have a reason not to.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.js"
  ],
  "exports": {
    ".": {
      "source": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "dependencies": {
    "@al-rayhaanat/tokens": "file:../tokens",
    "@al-rayhaanat/contracts": "file:../contracts",
    "@al-rayhaanat/icons": "file:../icons",
    "@al-rayhaanat/motion": "file:../motion",
    "@al-rayhaanat/ui": "file:../ui",
    "@al-rayhaanat/prose": "file:../prose",
    "@al-rayhaanat/table": "file:../table",
    "@al-rayhaanat/filters": "file:../filters",
    "@al-rayhaanat/patterns": "file:../patterns",
    "@al-rayhaanat/forms": "file:../forms",
    "@al-rayhaanat/shell": "file:../shell",
    "@al-rayhaanat/charts": "file:../charts",
    "@al-rayhaanat/slides": "file:../slides"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src"
  ],
  "arh": {
    "distribution": "source-jsx",
    "requiresTranspile": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idiot95/rayhanat-design-system.git",
    "directory": "packages/system"
  },
  "homepage": "https://github.com/idiot95/rayhanat-design-system#readme"
}
