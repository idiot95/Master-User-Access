{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directory.daeratulaqeeq.org/schemas/access-manifest.json",
  "title": "Access manifest",
  "description": "What a module declares it can be granted. Vocabulary, never data — a manifest carries no authority, and nothing in it can grant anyone anything.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "module", "revision", "generated", "resources"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$",
      "description": "Must equal Modules.Key for the row whose URL this was fetched from. A mismatch is rejected, so one module cannot claim another's identity."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Bumped by the module author on any change. Advisory only — the loader hashes the content itself and never trusts this alone."
    },
    "generated": { "type": "string", "format": "date-time" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "maxLength": 120 },
        "ar": { "type": "string", "maxLength": 120 }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "scopeDimensions": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/scopeDimension" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "vced": {
          "type": "array",
          "default": [],
          "items": { "enum": ["view", "create", "edit", "delete"] },
          "uniqueItems": true,
          "description": "Only the verbs this resource actually supports. Absence, not false. A checkbox for an operation the module cannot perform implies a control that does not exist."
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/capability" }
        },
        "scopeDimensions": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Keys into the top-level scopeDimensions[]. A resource omitting a dimension never receives scope claims of that kind, whatever the scope rule says."
        }
      },
      "anyOf": [
        { "required": ["vced"], "properties": { "vced": { "minItems": 1 } } },
        { "required": ["capabilities"], "properties": { "capabilities": { "minItems": 1 } } }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "not": { "enum": ["view", "create", "edit", "delete"] },
          "description": "Structurally barred from colliding with the VCED words, so the shared vocabulary cannot be smuggled past through this channel."
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source": {
          "enum": ["teable", "self"],
          "description": "teable is valid ONLY when the module stores record ids from User Access's own base. A field with a similar name is not enough — hoto's Jamiat is free text, so its ids would never match, and it must be self."
        },
        "teableScope": { "enum": ["Jamiat", "Section", "Umoor", "Initiative Year"] },
        "selfEndpoint": { "type": "string", "pattern": "^/\\.well-known/access-scopes/[a-z0-9_-]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "teable" } }, "required": ["source"] },
          "then": { "required": ["teableScope"] }
        },
        {
          "if": { "properties": { "source": { "const": "self" } }, "required": ["source"] },
          "then": { "required": ["selfEndpoint"] }
        }
      ]
    }
  }
}
