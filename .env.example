# ─────────────────────────────────────────────────────────────────────────────
# Access config — the five tables this app owns.
# ─────────────────────────────────────────────────────────────────────────────
TEABLE_ACCESS_URL=https://app.teable.io
TEABLE_ACCESS_BASE=              # MOD-User Access

# Scopes: base|read table|read view|read field|read record|read
#         record|create record|update      — on the access base ONLY.
TEABLE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Office register — people, roles, assignments. Read only, never written.
#
# A Teable token carries scopes AND an explicit base list, and those scopes
# apply across every base on the list. One token able to write access rows could
# also rewrite the office register, so these are separate: it makes "this app
# never writes org data" true at the credential rather than only in the code.
#
# Scopes: base|read table|read view|read field|read record|read   — nothing more.
# ─────────────────────────────────────────────────────────────────────────────
TEABLE_OFFICE_URL=https://app.teable.io
TEABLE_OFFICE_BASE=              # DA
TEABLE_OFFICE_TOKEN=

# Both default to TEABLE_URL when unset, which is the single-instance case.
# TEABLE_URL=http://127.0.0.1:3100

# ─────────────────────────────────────────────────────────────────────────────
# Sign-in — interim, until ITS One Login
#
# Signs the session cookie. There is deliberately no fallback: a missing secret
# stops the app rather than quietly making sessions forgeable.
#
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=

# Which salted-SHA-256 ordering the directory used when it wrote Auth Store.
# Left unset, every candidate is tried and the winner is reported on a
# successful sign-in — pin it here once, then it stops guessing.
#   salt+password | password+salt | password:salt | salt:password
# AUTH_HASH_SCHEME=

# ─────────────────────────────────────────────────────────────────────────────
# Local development only
# ─────────────────────────────────────────────────────────────────────────────

# Resolve @al-rayhaanat/* from ../rayhanat-design-system instead of the
# registry. Must NOT be set on a deployment — see DEPLOY.md.
# ARH_LOCAL=1

# Lets a request name an ITS ID with ?its=… instead of arriving from the
# directory. Guarded twice: it does nothing unless NODE_ENV is not production
# AND this is set. Never set it on a deployment — it turns identity into a
# query parameter.
# ALLOW_ITS_OVERRIDE=1

# Schema scripts need table|create, which neither app token carries. Point this
# at a browser cookie jar for those one-offs; the app never reads it.
# TEABLE_COOKIE=../teable-local/cookies.txt

# ─────────────────────────────────────────────────────────────────────────────
# The envelope signing key. Required — /authorize cannot issue without it.
#
# RS256: modules verify with the public half from /.well-known/jwks.json, so a
# leaked module env var cannot mint a token. There is deliberately no fallback
# default — a missing key must crash the boot rather than silently use a literal.
#
#   npm run keys           # printed, ready to paste
#   npm run keys -- --env  # as one-line .env lines
#
# Either real newlines or literal \n; both are accepted.
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_PRIVATE_KEY=
ACCESS_PUBLIC_KEY=

# Computed from the public key when unset, which is what you want. Set it only
# to keep a name a fleet already knows.
# ACCESS_KEY_ID=

# What modules check the `iss` claim against, and where they send people to
# sign in. Must match ACCESS_CONSOLE_URL in every module's environment. Fixed
# rather than taken from the request, so a preview deployment cannot issue
# envelopes that production modules would accept.
ACCESS_ISSUER=https://access.daeratulaqeeq.org

# The parent domain the envelope cookie is set on, so every module reads the
# same one. Leave UNSET for localhost — a browser will not scope a cookie to
# `.localhost`, and setting it there means the cookie is dropped in silence.
COOKIE_DOMAIN=.daeratulaqeeq.org

# ─────────────────────────────────────────────────────────────────────────────
# Identity, when something finally sits in front of this app.
#
# proxy.js strips inbound `x-its-id` on every request and sets it again from
# the verified session cookie, because nothing today stops a browser sending
# one. Set this to 1 only once ITS One Login terminates identity in front of
# the app and can be trusted to set that header itself.
# ─────────────────────────────────────────────────────────────────────────────
# TRUST_FORWARDED_ITS=1
