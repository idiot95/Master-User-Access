# ─────────────────────────────────────────────────────────────────────────────
# Access config — the five tables this app owns.
# ─────────────────────────────────────────────────────────────────────────────
TEABLE_ACCESS_URL=https://app.teable.io
TEABLE_ACCESS_BASE=              # MOD-User Access

# Scopes: base|read table|read view|read field|read record|read
#         record|create record|update      — on the access base ONLY.
TEABLE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Office register — people, roles, assignments. Read only, never written.
#
# A Teable token carries scopes AND an explicit base list, and those scopes
# apply across every base on the list. One token able to write access rows could
# also rewrite the office register, so these are separate: it makes "this app
# never writes org data" true at the credential rather than only in the code.
#
# Scopes: base|read table|read view|read field|read record|read   — nothing more.
# ─────────────────────────────────────────────────────────────────────────────
TEABLE_OFFICE_URL=https://app.teable.io
TEABLE_OFFICE_BASE=              # DA
TEABLE_OFFICE_TOKEN=

# Both default to TEABLE_URL when unset, which is the single-instance case.
# TEABLE_URL=http://127.0.0.1:3100

# ─────────────────────────────────────────────────────────────────────────────
# Local development only
# ─────────────────────────────────────────────────────────────────────────────

# Resolve @al-rayhaanat/* from ../rayhanat-design-system instead of the
# registry. Must NOT be set on a deployment — see DEPLOY.md.
# ARH_LOCAL=1

# Lets a request name an ITS ID with ?its=… instead of arriving from the
# directory. Guarded twice: it does nothing unless NODE_ENV is not production
# AND this is set. Never set it on a deployment — it turns identity into a
# query parameter.
# ALLOW_ITS_OVERRIDE=1

# Schema scripts need table|create, which neither app token carries. Point this
# at a browser cookie jar for those one-offs; the app never reads it.
# TEABLE_COOKIE=../teable-local/cookies.txt

# ─────────────────────────────────────────────────────────────────────────────
# Not yet wired — the envelope signing key.
#
# RS256: modules verify with the public half from /.well-known/jwks.json, so a
# leaked module env var cannot mint a token. There is deliberately no fallback
# default — a missing key must crash the boot rather than silently use a literal.
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_PRIVATE_KEY=
ACCESS_PUBLIC_KEY=
ACCESS_KEY_ID=
COOKIE_DOMAIN=.daeratulaqeeq.org
